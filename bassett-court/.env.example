# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit .env.local.
# In CI these live in GitHub → Settings → Secrets and variables → Actions.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://www.bassettcourtholdings.com"

# Which adapter `npm run sync` uses:
#   shiftly        authenticated Shiftly Auto API  (preferred)
#   feed           any authorized CSV / JSON / XML feed
#   sitemap-jsonld crawl the dealer website's sitemaps
#   demo           deterministic sample data
INVENTORY_SOURCE_ADAPTER="shiftly"

# --- Shiftly Auto ----------------------------------------------------------
# The inventory endpoint and credential. SHIFTLY_API_KEY is a secret: keep it
# out of the repository, out of screenshots and out of chat messages.
SHIFTLY_API_URL=""
SHIFTLY_API_KEY=""
# How the credential is presented: bearer (default) | header | query
SHIFTLY_AUTH_STYLE="bearer"
# Only used when SHIFTLY_AUTH_STYLE=header
SHIFTLY_AUTH_HEADER="X-API-Key"
# Only used when SHIFTLY_AUTH_STYLE=query
SHIFTLY_AUTH_PARAM="api_key"
# Optional: sent as dealer_id on every request
SHIFTLY_DEALER_ID=""

# --- Generic feed ----------------------------------------------------------
INVENTORY_FEED_URL=""

# --- Dealer website crawl --------------------------------------------------
INVENTORY_SOURCE_URL="https://www.escudechevrolet.com/"

# --- Appointment delivery --------------------------------------------------
# Where appointment requests are sent. A CRM endpoint, a Zapier/Make webhook,
# or an email service. Without this, requests only reach the server log.
LEAD_WEBHOOK_URL=""
