{
  "name": "bassett-court-holdings",
  "version": "1.0.0",
  "private": true,
  "description": "Bassett Court Holdings \u2014 vehicle inventory website with automated inventory syndication.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync-inventory.ts",
    "sync:dry": "tsx scripts/sync-inventory.ts --dry-run",
    "sync:demo": "tsx scripts/sync-inventory.ts --source=demo",
    "test": "tsx --test tests/*.test.ts",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check": "npm run typecheck && npm run test",
    "sync:probe": "tsx scripts/sync-inventory.ts --probe"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
