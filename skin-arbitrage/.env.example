# Copy to .env — never commit the real one.

# Shared database. For the two-server setup point BOTH servers at the same
# Postgres (runs on the scanner server via docker-compose).
DATABASE_URL=postgresql+psycopg2://arb:CHANGE_ME@localhost:5432/arbitrage
POSTGRES_PASSWORD=CHANGE_ME

# scanner | trader | all
ROLE=all

# Safety: "false" enables live trading. Leave true until you trust it.
DRY_RUN=true

# CSFloat: profile -> developer -> API key
CSFLOAT_API_KEY=

# DMarket: account settings -> API trading keys (ed25519 pair).
# REQUIRED even for scanning — DMarket's v2 API rejects unsigned requests.
# Without these the dmarket market is skipped (Rust scanning needs them).
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=

# Deal / trade notifications (either or both, optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
